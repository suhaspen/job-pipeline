# Copy to .env for local runs. NEVER commit .env.
# In CI these are GitHub Actions repository secrets, not a file.

# --- Notifications (Phase 2) -------------------------------------------------
# ntfy.sh topic. Treat as a password: anyone who knows it can read your pushes.
# Use something unguessable, e.g. `openssl rand -hex 16`.
NTFY_TOPIC=
# Companion topic the "Mark applied" button posts to. The pipeline reads this
# topic's JSON archive each run and flips matching rows to `applied`.
# Defaults to "${NTFY_TOPIC}-ack" if unset.
NTFY_ACK_TOPIC=
# Self-hosted ntfy server, if not using the public instance.
NTFY_SERVER=https://ntfy.sh

# --- Dead-man's switch (Phase 4) ---------------------------------------------
# Pinged on every successful run. A MISSED ping is the alarm, so configure the
# far end to alert after ~90 min of silence (3 missed 30-min runs).
HEALTHCHECK_URL=

# --- Triage (Phase 3) --------------------------------------------------------
# Hybrid triage: deterministic rules gate, LLM scores only the survivors.
# Without this key the pipeline degrades to rules-only scoring and still runs.
ANTHROPIC_API_KEY=
JOBPIPE_TRIAGE_MODEL=claude-sonnet-5

# --- Recruiter lookup (Phase 5, optional) ------------------------------------
# One of these enables the recruiter columns. Unset = columns stay null.
BRAVE_SEARCH_API_KEY=
SERPER_API_KEY=

# --- Google Sheets mirror (Phase 5, optional) --------------------------------
# Opt-in read-only view. Unset = mirror step skips cleanly.
GSHEETS_SPREADSHEET_ID=
GSHEETS_SERVICE_ACCOUNT_JSON=
