{
  "_comment": "Dedupe fixtures. Every posting inside a `must_collapse` group has to produce one identical id; every posting inside a `must_not_collapse` group has to produce a distinct id. Shapes here are drawn from how Greenhouse, Lever, Ashby and the Simplify/speedyapply repos actually word the same req.",

  "must_collapse": [
    {
      "why": "Classic repost: req closed and relisted. Legal suffix, comma-vs-dash separator, parenthetical Co-op, and South SF vs SF all differ.",
      "postings": [
        {
          "source": "greenhouse",
          "company": "Stripe, Inc.",
          "title": "Software Engineer Intern, Fall 2026 (Co-op)",
          "location": "South San Francisco, CA",
          "apply_url": "https://boards.greenhouse.io/stripe/jobs/1111",
          "source_id": "1111"
        },
        {
          "source": "simplify",
          "company": "Stripe",
          "title": "Software Engineer, Co-Op - Fall 2026",
          "location": "San Francisco, CA",
          "apply_url": "https://boards.greenhouse.io/stripe/jobs/2222",
          "source_id": "2222"
        }
      ]
    },
    {
      "why": "New-grad req seen by three sources with different grad wording, a start-date parenthetical, and a spelled-out state.",
      "postings": [
        {
